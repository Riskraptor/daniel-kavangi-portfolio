# ---------------------------------------------------------------------------
# Contact form delivery. Set these in Vercel:
#   Project -> Settings -> Environment Variables -> Redeploy
# ---------------------------------------------------------------------------

# Where contact messages are delivered.
CONTACT_TO_EMAIL=danielmwendwa494@gmail.com

# Preferred delivery path. With this set the API sends the message itself.
# https://resend.com
RESEND_API_KEY=
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Fallback delivery path. Free Web3Forms keys must be submitted from the
# browser, so the API hands the key back only after a request has passed the
# origin, captcha and rate-limit checks.
# https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# RECOMMENDED. Without this the API cannot verify the hCaptcha token itself and
# has to rely on Web3Forms to do it downstream, which disables direct Resend
# delivery. Create a site at https://dashboard.hcaptcha.com, then:
#   - put the site key in VITE_HCAPTCHA_SITEKEY
#   - put the secret in HCAPTCHA_SECRET (server-side only, never VITE_-prefixed)
HCAPTCHA_SECRET=

# Public hCaptcha site key used by the contact form widget. Safe to expose.
# Defaults to the shared Web3Forms site key when unset.
VITE_HCAPTCHA_SITEKEY=
